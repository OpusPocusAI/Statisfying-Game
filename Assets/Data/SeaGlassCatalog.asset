  upgrades:
  - id: scoop
    title: Sieve scoop
    description: Uncover and collect neighbouring finds in a wide circle.
    level: 2
    cost: 35
  - id: bucket
    title: Canvas collection sack
    description: Carry 14 finds. Fewer trips across the sand.
    level: 2
    cost: 40
  - id: truck
    title: Tall cargo dividers
    description: Forty secure cargo spaces for longer beach visits.
    level: 3
    cost: 65
  - id: washer
    title: Hand sprayer
    description: A visible spray wand cleans glass in three seconds.
    level: 2
    cost: 50
  - id: magnet
    title: Sorting magnet & light table
    description: Wide tray targeting and bright, generous mosaic guidance.
    level: 3
    cost: 55
  panelNames:
  - Ocean Wave
  - Lighthouse
  - Coastal Sunset
